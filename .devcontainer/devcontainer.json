{
  "name": "${localWorkspaceFolderBasename} — Nix Dev Environment",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile",
    "args": {
      "PRETTY_HOSTNAME": "${localWorkspaceFolderBasename} Repo"
    }
  },

  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  "mounts": [
    "source=/mnt/user-home,target=/mnt/user-home,type=bind",
    "source=lunarhue-containers-nix-store,target=/nix,type=volume"
  ],

  "containerEnv": {
    "CODEX_HOME": "/mnt/user-home/codex",
    "CLAUDE_CONFIG_DIR": "/mnt/user-home/claude",
    "BASH_ENV": "/home/vscode/.bashrc",
    "NIX_CONFIG": "experimental-features = nix-command flakes"
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "uid": "1000",
      "gid": "1000",
      "installZsh": false,
      "installOhMyZsh": false,
      "configureZshAsDefaultShell": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "false"
    }
  },

  "postCreateCommand": "bash .devcontainer/create.sh",
  "postStartCommand": "bash .devcontainer/start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "mkhl.direnv",
        "jnoortheen.nix-ide",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "forwardPorts": [3000],
  "remoteUser": "vscode"
}
